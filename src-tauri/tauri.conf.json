{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownTrack",
  "version": "1.0.0",
  "identifier": "app.downtrack.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "bun run build:tauri",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "DownTrack",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Hebrew", "English", "Arabic"], "displayLanguageSelector": true }
    }
  }
}
